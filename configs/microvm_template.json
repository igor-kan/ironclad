{
  "boot-source": {
    "kernel_image_path": "/var/lib/ironclad/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodules quiet init=/init ro"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/ironclad/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false
  },
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/run/ironclad/sandbox.vsock"
  },
  "balloon": {
    "amount_mib": 0,
    "deflate_on_oom": false
  }
}
